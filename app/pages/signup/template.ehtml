import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { signup, MIN_PASSWORD } from "#app/shared/services/auth";
import { BrandMark } from "#app/shared/templates/app-shell";

interface SignupForm {
  name: string;
  email: string;
  password: string;
  error: string;
  busy: boolean;
}

function onSubmit(form: SignupForm) {
  form.busy = true;

  try {
    signup(form.name, form.email, form.password);
    form.error = "";
    redirect("/");
  } catch (err: any) {
    form.error = err.message;
    form.busy = false;
  }
}

<html lang="en" class="page-signup" (
  private form: SignupForm = { name: "", email: "", password: "", error: "", busy: false },
)>
  <head>
    <title>Create an account · shortwick</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <main class="auth center">
      <div class="auth-column stack is-lg">
        <div class="auth-head stack is-sm">
          <BrandMark size={40} />
          <h1>Create your account</h1>
          <p>Free, and your first link takes ten seconds.</p>
        </div>

        <div class="card">
          <div class="card-body">
            <form class="stack" onsubmit={() => onSubmit(form)}>
              <p e:if={form.error} class="error" role="alert">{form.error}</p>

              <div class="field">
                <label for="name">Name</label>
                <input id="name" name="name" value={form.name} autocomplete="name" placeholder="Ada Lovelace">
              </div>

              <div class="field">
                <label for="email">Email</label>
                <input id="email"
                       name="email"
                       type="email"
                       value={form.email}
                       autocomplete="email"
                       autocapitalize="none"
                       spellcheck={false}
                       placeholder="you@example.com"
                       required>
              </div>

              <div class="field">
                <label for="password">Password</label>
                <input id="password"
                       name="password"
                       type="password"
                       value={form.password}
                       autocomplete="new-password"
                       minlength={MIN_PASSWORD}
                       required>
                <p class="hint">At least {MIN_PASSWORD} characters.</p>
              </div>

              <button type="submit" class={["is-primary is-block", form.busy && "is-loading"]}>Create account</button>
            </form>
          </div>
        </div>

        <p class="auth-alt">Already have an account? <a href="/signin">Sign in</a></p>
      </div>
    </main>
  </body>
</html>
