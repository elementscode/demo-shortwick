import "./style.css";
import { session, redirect } from "@elements/app";
import { signout } from "#app/shared/services/auth";

function onSignout() {
  signout();
  redirect("/signin");
}

<BrandMark (size: number = 26)>
  <svg class="brand-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="8" fill="var(--accent)"/>
    <path d="M16 5c3 4 6 7 6 11a6 6 0 0 1-12 0c0-2.5 1.5-4.5 3-6 .3 2 1.3 3 2.5 3.5C15 10 15.5 7.5 16 5z" fill="var(--accent-ink)"/>
    <rect x="15" y="21" width="2" height="6" rx="1" fill="var(--accent-ink)"/>
  </svg>
</BrandMark>

<AppShell (wide: boolean = false)>
  <div class="app">
    <header class="app-header">
      <div class={["page-shell app-header-inner row", wide && "is-wide"]}>
        <a href="/" class="brand row">
          <BrandMark />
          shortwick
        </a>

        <div e:if={session.isLoggedIn()} class="app-user row">
          <span class="app-user-name">{session.get("userName")}</span>
          <button class="is-ghost is-sm" onclick={() => onSignout()}>Sign out</button>
        </div>
      </div>
    </header>

    <main class={["app-main page-shell app-body", wide && "is-wide"]}>
      <slot/>
    </main>
  </div>
</AppShell>
